# Configuration for the next example.
# Copy to .env in this directory and fill in.
#
# NEXT_PUBLIC_JWT_TOKEN is a Courier client JWT, not a workspace API key.
# To issue one, and for which scopes it needs, see:
#   ../react-vite/README.md#generating-vite_jwt_token
# The tenant and template below must exist in the same workspace.

NEXT_PUBLIC_API_URL=https://api.courier.com/client/q
NEXT_PUBLIC_TENANT_ID=
NEXT_PUBLIC_TEMPLATE_ID=
NEXT_PUBLIC_JWT_TOKEN=
