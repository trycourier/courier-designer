# Configuration for the react-vite example.
# Copy to .env in this directory and fill in.
#
# VITE_JWT_TOKEN is a Courier client JWT, not a workspace API key.
# To issue one, and for which scopes it needs, see:
#   ./README.md#generating-vite_jwt_token
# The tenant and template below must exist in the same workspace.

VITE_API_URL=https://api.courier.com/client/q
VITE_JWT_TOKEN=
